// Cloudflare configuration for the Deep Jyoti Medical site.
// - The website (built into dist/) is served as static assets.
// - Everything under /api runs server/worker.js.
{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "deep-jyoti-medical",
	"main": "./server/worker.js",
	"compatibility_date": "2026-11-01",
	"assets": {
		"binding": "ASSETS",
		// Unknown paths get index.html so React Router can handle them.
		"not_found_handling": "single-page-application",
		// Only /api requests start the Worker; pages and images are served directly.
		"run_worker_first": ["/api/*"]
	},
	// Database: products, orders, customers, accounts.
	// On the first `npm run deploy`, Wrangler creates this database and writes its id back here.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "deep-jyoti-db"
		}
	],
	// File storage: uploaded prescriptions.
	"r2_buckets": [
		{
			"binding": "FILES",
			"bucket_name": "deep-jyoti-files"
		}
	],
	"vars": {
		// Sender shown on emails. Must be an address on a domain verified in Resend,
		// e.g. "Deep Jyoti Medical <orders@deepjyotimedical.com>". Leave empty to keep email off.
		"EMAIL_FROM": "",
		// Public address of the site, used for links inside emails, e.g. "https://deepjyotimedical.com".
		"PUBLIC_URL": "",
		// Comma-separated emails that become admins when they sign in (optional).
		"ADMIN_EMAILS": ""
	},
	"observability": {
		"enabled": true
	}
	// Secrets are NOT stored here. Set them with:
	//   npx wrangler secret put RESEND_API_KEY
}
